# CI image — used in GitHub Actions / GitLab CI pipelines.
# Contains the ci-setup binary and the Railway CLI (for `railway up` deploys).
# Build context: repo root
#   docker build -f docker/Dockerfile.ci -t railway-db-provisioner-ci .

FROM golang:1.26-alpine3.24 AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /ci-setup ./cmd/ci-setup

# Railway CLI image as the base — already has the `railway` binary on PATH.
FROM ghcr.io/railwayapp/cli:latest
COPY --from=builder /ci-setup /usr/local/bin/ci-setup
COPY ci-entrypoint.sh /usr/local/bin/ci-entrypoint.sh
WORKDIR /repo

ENTRYPOINT ["ci-entrypoint.sh"]
