# Environment variables for the CI pipeline (ci-setup + railway up).
# Copy to your CI provider's secret/variable store and adjust values.
#
# GitHub Actions:  Settings → Secrets and variables → Actions → Variables
# GitLab CI:       Settings → CI/CD → Variables
#
# See README → CI pipeline for full instructions.

# --- Required ---

# Railway API token — used by the Railway CLI for variable management and deploys.
# Generate at: https://railway.com/account/tokens
RAILWAY_TOKEN=

# Name of the provisioner service in your Railway project.
# Must match the service name shown in the Railway dashboard.
RAILWAY_SERVICE_NAME=DB-Provisioner

# --- Optional ---

# Path to the services file in your repo.
# Default: services.txt
#SERVICES_FILE=services.txt
