# Environment variables for the CI pipeline (ci-setup + deploy).
# Copy to your CI provider's secret/variable store and adjust values.
#
# GitHub Actions:  Settings → Secrets and variables → Actions → Variables
# GitLab CI:       Settings → CI/CD → Variables
#
# See README → CI pipeline for full instructions.

# --- Required ---

# Railway API token — must be a project token (scoped to one environment).
# Generate at: https://railway.com/account/tokens or from project settings.
RAILWAY_TOKEN=

# Name of the provisioner service in your Railway project.
# Must match the service name shown in the Railway dashboard.
RAILWAY_SERVICE_NAME=DB-Provisioner

# --- Optional ---

# Whether to wait for the deploy to complete and stream logs.
# true (default):  blocks until deploy finishes, prints status + logs, fails CI on deploy error
# false / 0:       triggers deploy and exits immediately (fire-and-forget)
#DEPLOY_WAIT=true

# Path to the cloned repo. Set this when the CI provider mounts the repo
# somewhere other than the image's WORKDIR.
# GitHub Actions: not needed (docker run -w /repo handles it)
# GitLab CI:       set to $CI_PROJECT_DIR
# Default: current directory
#REPO_DIR=/path/to/repo

# Path to the services file (relative to REPO_DIR if set).
# Default: services.txt
#SERVICES_FILE=services.txt

# --- Railway service variables (set in Railway dashboard, not CI) ---
#
# POSTGRES_SERVICE_NAME — name of the Postgres plugin/service in Railway.
#   ci-setup reads this from the provisioner service's variables and uses it
#   to build Railway variable references for host:port, e.g.
#     ${{Postgres-18.PGHOST}}  ${{Postgres-18.PGPORT}}
#   Railway resolves these at runtime, so the host is always current and
#   references follow service renames automatically.
