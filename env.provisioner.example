# Environment variables for the provisioner service (runs on Railway).
# Copy to your Railway service Variables tab and adjust values.
#
# See README → Railway setup for full instructions.

# --- Required ---

# Superuser connection string — reference the Postgres plugin variable.
POSTGRES_URL=${{Postgres-18.DATABASE_URL}}

# Name of the Postgres plugin/service in Railway.
# ci-setup reads this to build Railway variable references for host:port.
POSTGRES_SERVICE_NAME=Postgres-18

# --- Auto-generated (do not set manually) ---
# ci-setup creates these automatically on first run, using Railway references:
#   QUIZZER_POSTGRES_URL=postgresql://quizzer_user:pass@${{Postgres-18.PGHOST}}:${{Postgres-18.PGPORT}}/quizzer_db
#   AUTH_POSTGRES_URL=postgresql://auth_user:pass@${{Postgres-18.PGHOST}}:${{Postgres-18.PGPORT}}/auth_db

# --- Optional ---

# Path to the services file inside the container.
# Default: services.txt
#SERVICES_FILE=services.txt
